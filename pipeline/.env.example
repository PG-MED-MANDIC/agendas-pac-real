# Copie este arquivo para ".env" (nunca commitar o .env real). Mesma conta
# ConsultaJá já usada no pipeline do NPS-PACIENTE -- reaproveite o mesmo
# token de lá.

CONSULTAJA_TOKEN=
# Opcionais. START_DATE vazio = histórico completo. END_DATE vazio =
# calculado sozinho a cada execução (fim do mês, 2 meses à frente de hoje) --
# não precisa editar manualmente quando o mês virar. Só preencha aqui se
# quiser travar numa data fixa.
CONSULTAJA_START_DATE=
CONSULTAJA_END_DATE=
